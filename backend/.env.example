# Copy to backend/.env for local runs (never commit .env).
# Nimbus tries providers in order and falls back automatically: Groq, then Google, then OpenRouter
# (whichever keys are set). Set LLM_PROVIDERS="groq,openrouter" to choose the order yourself.

GROQ_API_KEY=                                  # primary, free tier: https://console.groq.com/keys
# GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=                            # backup: https://openrouter.ai/keys
# OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free   # used when OpenRouter is a backup
# OPENROUTER_MODEL=google/gemini-2.5-flash                           # used only if OpenRouter is first (paid)

# GOOGLE_API_KEY=
# SITE_URL=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173
# RATE_LIMIT_PER_IP=15
# RATE_LIMIT_DAILY=300
